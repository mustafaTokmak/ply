    "/v1/actions/update_settings" : {
      "post" : {
        "description" : "Change one or more settings. Pass only the keys to change.",
        "operationId" : "update_settings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "additionalProperties" : false,
                "properties" : {
                  "combineAuto" : {
                    "description" : "Start Combine automatically when iPhone USB and another link (Wi-Fi or Ethernet) both have internet. Stopping Combine by hand keeps it off until a link drops and comes back. Default false.",
                    "type" : "boolean"
                  },
                  "leaveIPhoneWiFiWhenUSB" : {
                    "description" : "If the Mac joins the iPhone's Wi-Fi hotspot while USB is up, leave it (frees Wi-Fi for a real network). Skipped while combining. Default true.",
                    "type" : "boolean"
                  },
                  "preferUSB" : {
                    "description" : "Keep iPhone USB above Wi-Fi in macOS's service order and turn off its \"Disable unless needed\" switch, so the cable wins whenever it is connected. Turning it off puts Wi-Fi back above iPhone USB. Needs the helper. Default true.",
                    "type" : "boolean"
                  },
                  "speedTestMaxMB" : {
                    "description" : "Most megabytes speed_test may download per link per phase (mobile data). 5 to 500. Default 40.",
                    "type" : "integer"
                  },
                  "speedTestURL" : {
                    "description" : "HTTPS download URL used by speed_test. Default is Cloudflare's speed endpoint.",
                    "type" : "string"
                  },
                  "split" : {
                    "description" : "How Combine spreads traffic: 'connection' (fastest, per connection) or 'site' (one link per site for 10 minutes). Default connection.",
                    "enum" : [
                      "connection",
                      "site"
                    ],
                    "type" : "string"
                  },
                  "systemProxy" : {
                    "description" : "While combining, point macOS's auto-proxy (PAC) at Ply so browsers and most apps use both links. Needs the helper. Default true.",
                    "type" : "boolean"
                  },
                  "tetherInterfaces" : {
                    "description" : "Extra BSD interface names (e.g. en9) to treat as a phone tether, for Android or other USB modems.",
                    "items" : {
                      "type" : "string"
                    },
                    "type" : "array"
                  },
                  "uiMode" : {
                    "description" : "How much the menu shows: 'simple' (status and the two main switches) or 'advanced' (every setting, each link and speed results). Default simple.",
                    "enum" : [
                      "simple",
                      "advanced"
                    ],
                    "type" : "string"
                  },
                  "wifiOffWhenUSB" : {
                    "description" : "Turn Wi-Fi off while iPhone USB is up and back on when it goes away. Ignored while combining. Default false.",
                    "type" : "boolean"
                  }
                },
                "type" : "object"
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
                }
              }
            },
            "description" : "Result as JSON"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Bad parameters"
          },
          "401" : {
            "description" : "Missing or wrong token"
          },
          "default" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Error"
                }
              }
            },
            "description" : "Error"
          }
        },
        "summary" : "Change settings",
        "x-cli" : "ply settings set key=value [key=value ...]",
        "x-mcp-tool" : "ply_update_settings",
        "x-read-only" : false
      }
